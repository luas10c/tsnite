{
  "name": "tsnite",
  "description": "TypeScript at full throttle—fast, safe, unstoppable. 🚀",
  "version": "0.2.4",
  "keywords": [
    "cli",
    "esm",
    "watch",
    "nodejs",
    "typescript"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "package.json"
  ],
  "bin": {
    "tsnite": "dist/cli.js"
  },
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "postbuild": "tsc-alias -f -p tsconfig.build.json",
    "lint": "eslint . --cache",
    "test": "node --experimental-vm-modules --no-warnings node_modules/.bin/jest --passWithNoTests --verbose",
    "test:ci": "node --experimental-vm-modules --no-warnings node_modules/.bin/jest --passWithNoTests --ci",
    "test:watch": "node --experimental-vm-modules --no-warnings node_modules/.bin/jest --passWithNoTests --watch",
    "test:watchAll": "node --experimental-vm-modules --no-warnings node_modules/.bin/jest --passWithNoTests --watchAll",
    "test:coverage": "node --experimental-vm-modules --no-warnings node_modules/.bin/jest --passWithNoTests --coverage",
    "prepare": "husky"
  },
  "dependencies": {
    "@swc/core": "^1.16.21",
    "chokidar": "^6.0.0",
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@jest/globals": "^30.5.2",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@swc/jest": "^0.2.39",
    "eslint": "^10.14.0",
    "eslint-plugin-jest": "^29.17.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "jest-environment-node": "^30.5.2",
    "neostaged": "^0.2.0",
    "rimraf": "^6.1.3",
    "tsc-alias": "^1.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  },
  "engines": {
    "node": ">=20"
  },
  "author": {
    "name": "Luciano Alves",
    "url": "https://github.com/luas10c"
  },
  "homepage": "https://github.com/luas10c/tsnite",
  "repository": {
    "type": "github",
    "url": "git+https://github.com/luas10c/tsnite.git"
  },
  "bugs": {
    "url": "https://gitbub.com/luas10c/tsnite/issues"
  },
  "license": "MIT"
}
